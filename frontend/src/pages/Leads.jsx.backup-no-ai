import React, { useEffect, useMemo, useState } from 'react';
import api from '../services/api';

export default function Leads({ user }) {
  const defaultLeads = [
    ['Brian Mwangi', 'brian@safaricom.co.ke', 'Safaricom Ltd', 'Negotiation', 'KES 850K', '92', 'Sarah K.'],
    ['Alice Njoroge', 'alice@kcb.co.ke', 'KCB Group', 'Proposal', 'KES 420K', '78', 'Mike O.'],
    ['James Kariuki', 'j.kariuki@kplc.co.ke', 'KPLC', 'Qualified', 'KES 200K', '65', 'Sarah K.']
  ];

  const [leadList, setLeadList] = useState(() => {
    return JSON.parse(localStorage.getItem('crm_leads') || 'null') || defaultLeads;
  });

  const [search, setSearch] = useState('');
  const [stageFilter, setStageFilter] = useState('All');
  const [repFilter, setRepFilter] = useState('All');
  const [showAddLead, setShowAddLead] = useState(false);
  const [editingLeadIndex, setEditingLeadIndex] = useState(null);

  const [newLead, setNewLead] = useState({
    name: '',
    email: '',
    company: '',
    stage: 'New',
    value: '',
    score: '',
    rep: ''
  });

  useEffect(() => {
    localStorage.setItem('crm_leads', JSON.stringify(leadList));
  }, [leadList]);

  const parseMoney = (value) => {
    if (!value) return 0;

    let clean = String(value)
      .replace(/KES/gi, '')
      .replace(/,/g, '')
      .trim()
      .toUpperCase();

    if (clean.endsWith('M')) return parseFloat(clean) * 1000000;
    if (clean.endsWith('K')) return parseFloat(clean) * 1000;

    return Number(clean) || 0;
  };

  const formatMoney = (amount) => {
    if (amount >= 1000000) return `KES ${(amount / 1000000).toFixed(1)}M`;
    if (amount >= 1000) return `KES ${(amount / 1000).toFixed(0)}K`;
    return `KES ${amount.toLocaleString()}`;
  };

  const filteredLeads = useMemo(() => {
    return leadList.filter(lead => {
      const text = lead.join(' ').toLowerCase();
      return (
        text.includes(search.toLowerCase()) &&
        (stageFilter === 'All' || lead[3] === stageFilter) &&
        (repFilter === 'All' || lead[6] === repFilter)
      );
    });
  }, [leadList, search, stageFilter, repFilter]);

  const pipelineTotal = filteredLeads.reduce((sum, lead) => sum + parseMoney(lead[4]), 0);
  const avgDeal = filteredLeads.length ? pipelineTotal / filteredLeads.length : 0;
  const conversionRate = filteredLeads.length ? Math.round((filteredLeads.filter(l => l[3] === 'Negotiation').length / filteredLeads.length) * 100) : 0;

  const saveLead = () => {
    if (!newLead.name || !newLead.email || !newLead.company || !newLead.value) {
      alert('Fill contact name, email, company and order value');
      return;
    }

    const lead = [
      newLead.name,
      newLead.email,
      newLead.company,
      newLead.stage,
      newLead.value.startsWith('KES') ? newLead.value : `KES ${newLead.value}`,
      newLead.score || '50',
      newLead.rep || user?.name || 'Admin'
    ];

    const updatedLeads = [lead, ...leadList];

    setLeadList(updatedLeads);
    localStorage.setItem('crm_leads', JSON.stringify(updatedLeads));

    setNewLead({
      name: '',
      email: '',
      company: '',
      stage: 'New',
      value: '',
      score: '',
      rep: ''
    });

    setSearch('');
    setStageFilter('All');
    setRepFilter('All');
    setShowAddLead(false);

    alert('Lead added successfully');
  };

  const openEditLead = (lead, index) => {
    setEditingLeadIndex(index);
    setNewLead({
      name: lead[0],
      email: lead[1],
      company: lead[2],
      stage: lead[3],
      value: lead[4],
      score: lead[5],
      rep: lead[6]
    });
    setShowAddLead(true);
  };

  const saveEditedLead = () => {
    if (editingLeadIndex === null) return;

    const updatedLeads = leadList.map((lead, index) =>
      index === editingLeadIndex
        ? [
            newLead.name,
            newLead.email,
            newLead.company,
            newLead.stage,
            newLead.value.startsWith('KES') ? newLead.value : `KES ${newLead.value}`,
            newLead.score || '50',
            newLead.rep || user?.name || 'Admin'
          ]
        : lead
    );

    setLeadList(updatedLeads);
    localStorage.setItem('crm_leads', JSON.stringify(updatedLeads));

    setEditingLeadIndex(null);
    setShowAddLead(false);

    setNewLead({
      name: '',
      email: '',
      company: '',
      stage: 'New',
      value: '',
      score: '',
      rep: ''
    });

    alert('Lead updated successfully');
  };

  const handleImport = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    const fd = new FormData();
    fd.append('file', file);

    try {
      const res = await api.post('/leads/import', fd, {
        headers: { 'Content-Type': 'multipart/form-data' }
      });

      alert(`Successfully imported ${res.data.count || 0} leads`);
      window.location.reload();
    } catch (err) {
      console.error(err);
      alert('Import failed. Backend route /api/leads/import may not be ready yet.');
    }
  };

  const stageClass = stage =>
    stage === 'New' ? 'stage new-stage' :
    stage === 'Negotiation' ? 'stage negotiation' :
    stage === 'Proposal' ? 'stage proposal' :
    'stage qualified';

  return (
    <section className="lead-crm-page">

      <div className="crm-leads-header">
        <div>
          <h2>CRM & Leads</h2>
          <p>{filteredLeads.length} visible leads · {formatMoney(pipelineTotal)} pipeline</p>
        </div>

        <div className="leads-actions">
          <input
            type="file"
            id="leadCsvUpload"
            accept=".csv,.xlsx,.xls"
            style={{ display: 'none' }}
            onChange={handleImport}
          />

          <button className="import-btn" onClick={() => document.getElementById('leadCsvUpload').click()}>
            Import CSV
          </button>

          <button
            className="import-btn"
            onClick={() => {
              setEditingLeadIndex(null);
              setNewLead({
                name: '',
                email: '',
                company: '',
                stage: 'New',
                value: '',
                score: '',
                rep: ''
              });
              setShowAddLead(true);
            }}
          >
            + Add Lead
          </button>
        </div>
      </div>

      <div className="lead-stats-grid">
        <div className="lead-stat blue"><p>TOTAL LEADS</p><h3>{filteredLeads.length}</h3><span>↑ filtered result</span></div>
        <div className="lead-stat cyan"><p>CONVERSION RATE</p><h3>{conversionRate}%</h3><span>Negotiation stage</span></div>
        <div className="lead-stat green"><p>PIPELINE VALUE</p><h3>{formatMoney(pipelineTotal)}</h3><small>From order values</small></div>
        <div className="lead-stat orange"><p>AVG DEAL SIZE</p><h3>{formatMoney(avgDeal)}</h3><span>Per lead</span></div>
      </div>

      <div className="lead-filter-panel">
        <div>
          <h3>Lead Directory</h3>
          <p>Search and filter leads by contact, company, stage, order value, score or sales rep.</p>
        </div>

        <div className="lead-filter-actions">
          <input placeholder="Search leads..." value={search} onChange={e => setSearch(e.target.value)} />

          <select value={stageFilter} onChange={e => setStageFilter(e.target.value)}>
            <option>All</option>
            <option>New</option>
            <option>Qualified</option>
            <option>Proposal</option>
            <option>Negotiation</option>
          </select>

          <select value={repFilter} onChange={e => setRepFilter(e.target.value)}>
            <option>All</option>
            <option>Sarah K.</option>
            <option>Mike O.</option>
            <option>Admin</option>
            {user?.name && <option>{user.name}</option>}
          </select>
        </div>
      </div>

      <div className="lead-table-card">
        <table className="crm-leads-table">
          <thead>
            <tr>
              <th>CONTACT</th>
              <th>COMPANY</th>
              <th>STAGE</th>
              <th>ORDER VALUE</th>
              <th>AI SCORE</th>
              <th>REP</th>
              <th>ACTIONS</th>
            </tr>
          </thead>

          <tbody>
            {filteredLeads.map((lead, i) => (
              <tr key={`${lead[1]}-${i}`}>
                <td><strong>{lead[0]}</strong><small>{lead[1]}</small></td>
                <td>{lead[2]}</td>
                <td><span className={stageClass(lead[3])}>{lead[3]}</span></td>
                <td>{lead[4]}</td>
                <td><b className="ai-score">{lead[5]}</b></td>
                <td>{lead[6]}</td>
                <td>
                  <button className="lead-edit-btn" onClick={() => openEditLead(lead, leadList.indexOf(lead))}>
                    Edit
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <div className="clean-pagination">
          <span>Showing 1–{filteredLeads.length} of {filteredLeads.length} leads</span>
        </div>
      </div>

      {showAddLead && (
        <div className="modal-overlay">
          <div className="customer-popup">
            <div className="popup-header">
              <h3>{editingLeadIndex === null ? 'Add New Lead' : 'Edit Lead'}</h3>
              <button className="close-btn" onClick={() => {
                setShowAddLead(false);
                setEditingLeadIndex(null);
              }}>×</button>
            </div>

            <form className="popup-form">
              <input placeholder="Contact Name" value={newLead.name} onChange={e => setNewLead({...newLead, name:e.target.value})} />
              <input placeholder="Email Address" value={newLead.email} onChange={e => setNewLead({...newLead, email:e.target.value})} />
              <input placeholder="Company Name" value={newLead.company} onChange={e => setNewLead({...newLead, company:e.target.value})} />

              <input
                placeholder="Order Value e.g 50000, KES 50K, KES 1.2M"
                value={newLead.value}
                onChange={e => setNewLead({...newLead, value:e.target.value})}
              />

              <input placeholder="AI Score e.g 75" value={newLead.score} onChange={e => setNewLead({...newLead, score:e.target.value})} />
              <input placeholder="Sales Rep" value={newLead.rep} onChange={e => setNewLead({...newLead, rep:e.target.value})} />

              <select value={newLead.stage} onChange={e => setNewLead({...newLead, stage:e.target.value})}>
                <option>New</option>
                <option>Qualified</option>
                <option>Proposal</option>
                <option>Negotiation</option>
              </select>

              <div className="popup-actions">
                <button type="button" className="secondary-btn" onClick={() => {
                  setShowAddLead(false);
                  setEditingLeadIndex(null);
                }}>Cancel</button>

                <button
                  type="button"
                  className="primary-btn"
                  onClick={editingLeadIndex === null ? saveLead : saveEditedLead}
                >
                  {editingLeadIndex === null ? 'Save Lead' : 'Save Changes'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </section>
  );
}
