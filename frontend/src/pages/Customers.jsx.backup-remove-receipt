import React, { useEffect, useMemo, useState } from 'react';
import kiambuLogo from '../assets/kiambu-logo.jpeg';

export default function Customers() {
  const defaultCustomers = [
    ['CUST-001', 'John Kamau', '0700000001', 'john@email.com', 'Kiambu', 'Farmer', 'KES 5,000', 'Paid'],
    ['CUST-002', 'Mary Njeri', '0700000002', 'mary@email.com', 'Nairobi', 'Retailer', 'KES 12,500', 'Pending'],
    ['CUST-003', 'Agrovet Kiambu', '0700000003', 'sales@agrovet.co.ke', 'Kiambu', 'Agrovet', 'KES 32,000', 'Paid'],
  ];

  const [customers, setCustomers] = useState(() => {
    return JSON.parse(localStorage.getItem('crm_customers') || 'null') || defaultCustomers;
  });

  const [search, setSearch] = useState('');
  const [typeFilter, setTypeFilter] = useState('All');
  const [page, setPage] = useState(1);
  const [showAddCustomer, setShowAddCustomer] = useState(false);

  const [newCustomer, setNewCustomer] = useState({
    name: '',
    phone: '',
    email: '',
    county: '',
    type: 'Farmer',
    totalPaid: '',
    status: 'Pending'
  });

  const perPage = 10;

  useEffect(() => {
    localStorage.setItem('crm_customers', JSON.stringify(customers));
  }, [customers]);

  const filtered = useMemo(() => {
    return customers.filter(c => {
      const text = c.join(' ').toLowerCase();
      return text.includes(search.toLowerCase()) && (typeFilter === 'All' || c[5] === typeFilter);
    });
  }, [customers, search, typeFilter]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
  const paginated = filtered.slice((page - 1) * perPage, page * perPage);

  const saveCustomer = () => {
    if (!newCustomer.name || !newCustomer.phone || !newCustomer.email) {
      alert('Fill customer name, phone and email');
      return;
    }

    const customer = [
      `CUST-${String(customers.length + 1).padStart(3, '0')}`,
      newCustomer.name,
      newCustomer.phone,
      newCustomer.email,
      newCustomer.county || 'N/A',
      newCustomer.type,
      newCustomer.totalPaid
        ? newCustomer.totalPaid.startsWith('KES')
          ? newCustomer.totalPaid
          : `KES ${newCustomer.totalPaid}`
        : 'KES 0',
      newCustomer.status
    ];

    const updatedCustomers = [customer, ...customers];
    setCustomers(updatedCustomers);
    localStorage.setItem('crm_customers', JSON.stringify(updatedCustomers));

    setNewCustomer({
      name: '',
      phone: '',
      email: '',
      county: '',
      type: 'Farmer',
      totalPaid: '',
      status: 'Pending'
    });

    setSearch('');
    setTypeFilter('All');
    setPage(1);
    setShowAddCustomer(false);

    alert('Customer added successfully');
  };

  const openCustomerPdf = (c) => {
    const html = `
      <html>
      <head>
        <title>${c[1]} Profile</title>
        <style>
          body{font-family:Arial;padding:35px;background:#f6faf4}
          .doc{max-width:780px;margin:auto;background:white;border-radius:22px;padding:38px;border:1px solid #dce8d7}
          .head{text-align:center;border-bottom:2px solid #2f6f27;padding-bottom:20px}
          .doc-logo{width:92px;height:92px;object-fit:contain;border-radius:18px;margin:0 auto 14px;display:block;}
          h1{color:#2f6f27;margin:8px 0 0}
          h3{color:#6b3b2a;margin:6px 0}
          .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:25px}
          .box{border:1px solid #e2eadf;border-radius:16px;padding:16px}
          .box small{color:#66746a;display:block;margin-bottom:6px}
          .box b{font-size:18px;color:#111}
          .status{display:inline-block;background:#dcfce7;color:#166534;padding:8px 16px;border-radius:999px;font-weight:bold}
          .footer{text-align:center;margin-top:28px;color:#66746a;font-size:13px}
        </style>
      </head>
      <body>
        <div class="doc">
          <div class="head">
            <img src="${kiambuLogo}" class="doc-logo" />
            <h1>KIAMBU FERTILIZERS COMPANY LIMITED</h1>
            <h3>THE FARMER’S FRIEND · ESTABLISHED IN 1969</h3>
            <p>Customer Profile Document</p>
          </div>

          <div class="grid">
            <div class="box"><small>Customer ID</small><b>${c[0]}</b></div>
            <div class="box"><small>Full Name</small><b>${c[1]}</b></div>
            <div class="box"><small>Phone</small><b>${c[2]}</b></div>
            <div class="box"><small>Email</small><b>${c[3]}</b></div>
            <div class="box"><small>County</small><b>${c[4]}</b></div>
            <div class="box"><small>Customer Type</small><b>${c[5]}</b></div>
            <div class="box"><small>Total Paid</small><b>${c[6]}</b></div>
            <div class="box"><small>Status</small><span class="status">${c[7]}</span></div>
          </div>

          <p class="footer">Generated on ${new Date().toLocaleString()} · Kiambu CRM</p>
        </div>
      </body>
      </html>
    `;

    const win = window.open('', '_blank');
    win.document.write(html);
    win.document.close();
  };

  const printReceipt = (c) => {
    const amountNumber = Number(String(c[6]).replace(/KES/gi, '').replace(/,/g, '').trim()) || 0;
    const vatRate = 0.16;
    const subtotal = Math.round(amountNumber / (1 + vatRate));
    const vat = amountNumber - subtotal;

    const productName = c[8] || 'Fertilizer / Agro Product';
    const quantity = c[9] || 1;
    const unitPrice = Math.round(subtotal / quantity);

    const html = `
      <html>
      <head>
        <title>${c[0]} Receipt</title>
        <style>
          @page{
            size:A4;
            margin:10mm;
          }

          *{
            box-sizing:border-box;
          }

          body{
            font-family:Arial,sans-serif;
            padding:0;
            margin:0;
            background:#f6faf4;
            color:#111;
            -webkit-print-color-adjust:exact;
            print-color-adjust:exact;
          }

          .receipt{
            width:100%;
            max-width:760px;
            margin:auto;
            background:white;
            border-radius:18px;
            padding:22px;
            border:1px solid #dce8d7;
            overflow:hidden;
            page-break-inside:avoid;
            position:relative;
          }

          .watermark{
            position:absolute;
            top:45%;
            left:50%;
            transform:translate(-50%,-50%) rotate(-32deg);
            font-size:120px;
            font-weight:900;
            color:#15803d;
            opacity:0.08;
            letter-spacing:12px;
            z-index:0;
            pointer-events:none;
            white-space:nowrap;
          }

          .receipt > *{
            position:relative;
            z-index:2;
          }
          .top{text-align:center;border-bottom:2px solid #2f6f27;padding-bottom:10px;margin-bottom:12px}
          .doc-logo{width:72px;height:72px;object-fit:contain;border-radius:16px;margin:0 auto 8px;display:block}
          h1{color:#2f6f27;margin:4px 0;font-size:20px;line-height:1.2}
          h3{color:#6b3b2a;margin:0 0 8px;font-size:15px}
          .paid{display:inline-block;background:#dcfce7;color:#166534;padding:6px 14px;border-radius:999px;font-weight:bold;font-size:12px}
          .details{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
          .box{border:1px solid #edf1ea;border-radius:12px;padding:8px}
          .box small{display:block;color:#66746a;margin-bottom:5px}
          table{width:100%;border-collapse:collapse;margin-top:10px;font-size:13px}
          th{background:#eef6ec;color:#185c22;text-align:left;padding:8px}
          td{padding:8px;border-bottom:1px solid #edf1ea}
          .totals{margin-top:12px;margin-left:auto;width:260px;font-size:13px}
          .row{display:flex;justify-content:space-between;border-bottom:1px solid #edf1ea;padding:7px 0}
          .grand{font-size:18px;color:#2f6f27;font-weight:900}
          .thanks{text-align:center;margin-top:14px;color:#6b3b2a;font-weight:bold;font-size:13px}
        </style>
      </head>
      <body>
        <div class="receipt">
            <div class="watermark">PAID</div>
          <div class="top">
            <img src="${kiambuLogo}" class="doc-logo" />
            <h1>KIAMBU FERTILIZERS COMPANY LIMITED</h1>
            <h3>OFFICIAL PAYMENT RECEIPT</h3>
            <span class="paid">${c[7]}</span>
          </div>

          <div class="details">
            <div class="box"><small>Receipt No.</small><b>RCT-${Date.now()}</b></div>
            <div class="box"><small>Date</small><b>${new Date().toLocaleString()}</b></div>
            <div class="box"><small>Customer ID</small><b>${c[0]}</b></div>
            <div class="box"><small>Customer</small><b>${c[1]}</b></div>
            <div class="box"><small>Phone</small><b>${c[2]}</b></div>
            <div class="box"><small>Email</small><b>${c[3]}</b></div>
          </div>

          <table>
            <thead>
              <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>${productName}</td>
                <td>${quantity}</td>
                <td>KES ${unitPrice.toLocaleString()}</td>
                <td>KES ${subtotal.toLocaleString()}</td>
              </tr>
            </tbody>
          </table>

          <div class="totals">
            <div class="row"><span>Subtotal</span><b>KES ${subtotal.toLocaleString()}</b></div>
            <div class="row"><span>VAT 16%</span><b>KES ${vat.toLocaleString()}</b></div>
            <div class="row grand"><span>Total Paid</span><b>KES ${amountNumber.toLocaleString()}</b></div>
          </div>

          <p class="thanks">Thank you for choosing Kiambu Fertilizers.</p>
        </div>
      </body>
      </html>
    `;

    const win = window.open('', '_blank');
    win.document.write(html);
    win.document.close();
    win.focus();
    setTimeout(() => win.print(), 300);
  };

  return (
    <section>
      <div className="page-header premium-header">
        <div>
          <h2>Customers</h2>
          <p>Manage customers, payment status and customer records.</p>
        </div>

        <button className="green-btn" onClick={() => setShowAddCustomer(true)}>
          + Add Customer
        </button>
      </div>

      <div className="panel">
        <div className="table-toolbar">
          <div>
            <h3>Customer List</h3>
            <p>Add, search, filter, view and print customer records.</p>
          </div>

          <div className="toolbar-actions">
            <input
              className="search-input"
              placeholder="Search customers..."
              value={search}
              onChange={e => {
                setSearch(e.target.value);
                setPage(1);
              }}
            />

            <select
              className="filter-select"
              value={typeFilter}
              onChange={e => {
                setTypeFilter(e.target.value);
                setPage(1);
              }}
            >
              <option>All</option>
              <option>Farmer</option>
              <option>Retailer</option>
              <option>Agrovet</option>
            </select>
          </div>
        </div>

        <table className="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>County</th>
              <th>Type</th>
              <th>Total Paid</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {paginated.map(c => (
              <tr key={c[0]}>
                <td><strong>{c[0]}</strong></td>
                <td>{c[1]}</td>
                <td>{c[2]}</td>
                <td>{c[3]}</td>
                <td>{c[4]}</td>
                <td>{c[5]}</td>
                <td>{c[6]}</td>
                <td>
                  <span className={c[7] === 'Paid' ? 'status success' : 'status warning'}>
                    {c[7]}
                  </span>
                </td>
                <td>
                  <div className="customer-action-buttons">
                    <button onClick={() => openCustomerPdf(c)}>View</button>

                    {c[7] === 'Paid' ? (
                      <>
                        <button onClick={() => printReceipt(c)}>Print</button>
                        <button className="receipt-btn" onClick={() => printReceipt(c)}>Receipt</button>
                      </>
                    ) : (
                      <span className="action-muted">Not Paid</span>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <div className="clean-pagination">
          <span>
            Showing {paginated.length ? ((page - 1) * perPage) + 1 : 0}–
            {Math.min(page * perPage, filtered.length)} of {filtered.length} customers
          </span>

          <div className="pagination-controls">
            <button className="page-btn" disabled={page <= 1} onClick={() => setPage(page - 1)}>←</button>
            <button className="page-number active">{page}</button>
            <button className="page-btn" disabled={page >= totalPages} onClick={() => setPage(page + 1)}>→</button>
          </div>
        </div>
      </div>

      {showAddCustomer && (
        <div className="modal-overlay">
          <div className="customer-popup">
            <div className="popup-header">
              <h3>Add Customer</h3>
              <button className="close-btn" onClick={() => setShowAddCustomer(false)}>×</button>
            </div>

            <form className="popup-form">
              <input placeholder="Full Name" value={newCustomer.name} onChange={e => setNewCustomer({...newCustomer, name:e.target.value})} />
              <input placeholder="Phone Number" value={newCustomer.phone} onChange={e => setNewCustomer({...newCustomer, phone:e.target.value})} />
              <input placeholder="Email Address" value={newCustomer.email} onChange={e => setNewCustomer({...newCustomer, email:e.target.value})} />
              <input placeholder="County / Location" value={newCustomer.county} onChange={e => setNewCustomer({...newCustomer, county:e.target.value})} />
              <input placeholder="Total Paid e.g 5000 or KES 5,000" value={newCustomer.totalPaid} onChange={e => setNewCustomer({...newCustomer, totalPaid:e.target.value})} />

              <select value={newCustomer.type} onChange={e => setNewCustomer({...newCustomer, type:e.target.value})}>
                <option>Farmer</option>
                <option>Retailer</option>
                <option>Agrovet</option>
              </select>

              <select value={newCustomer.status} onChange={e => setNewCustomer({...newCustomer, status:e.target.value})}>
                <option>Pending</option>
                <option>Paid</option>
              </select>

              <div className="popup-actions">
                <button type="button" className="secondary-btn" onClick={() => setShowAddCustomer(false)}>Cancel</button>
                <button type="button" className="primary-btn" onClick={saveCustomer}>Save Customer</button>
              </div>
            </form>
          </div>
        </div>
      )}

    </section>
  );
}
