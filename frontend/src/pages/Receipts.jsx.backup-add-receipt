import React, { useMemo, useState } from 'react';
import kiambuLogo from '../assets/kiambu-logo.jpeg';

export default function Receipts() {
  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState('All');
  const [page, setPage] = useState(1);
  const [selectedReceipt, setSelectedReceipt] = useState(null);
  const perPage = 10;

  const receipts = [
    ['RCT-001', 'INV-001', 'John Kamau', 'john@email.com', 'KES 5,000', 'Paid', '2026-05-18', '0700000001', 'Kiambu', 'CAN Fertilizer 50KG', 1, 4310, 16, 'M-PESA'],
    ['RCT-002', 'INV-008', 'Peter Otieno', 'peter@email.com', 'KES 15,000', 'Paid', '2026-05-12', '0700000002', 'Nairobi', 'DAP Fertilizer 50KG', 2, 6466, 16, 'Cash'],
    ['RCT-003', 'INV-010', 'David Mutua', 'david@email.com', 'KES 3,900', 'Pending', '2026-05-10', '0700000003', 'Kiambu', 'Agro Product', 1, 3362, 16, 'Pending']
  ];

  const filtered = useMemo(() => {
    return receipts.filter(r => {
      const text = r.join(' ').toLowerCase();
      return text.includes(search.toLowerCase()) && (statusFilter === 'All' || r[5] === statusFilter);
    });
  }, [search, statusFilter]);

  const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
  const paginated = filtered.slice((page - 1) * perPage, page * perPage);

  const printReceipt = (r) => {
    const receiptNo = r[0];
    const invoiceNo = r[1];
    const customer = r[2];
    const email = r[3];
    const amount = r[4];
    const status = r[5];
    const receiptDate = r[6];
    const phone = r[7] || 'No phone';
    const address = r[8] || 'No address';
    const product = r[9] || 'Agro Product';
    const qty = Number(r[10] || 1);
    const unitPrice = Number(r[11] || 0);
    const vatRate = Number(r[12] || 16);
    const paymentMethod = r[13] || 'Payment';

    const subtotal = qty * unitPrice;
    const vat = Math.round(subtotal * (vatRate / 100));
    const total = subtotal + vat;
    const generatedAt = new Date().toLocaleString('en-KE');

    const html = `
      <html>
      <head>
        <title>${receiptNo}</title>

        <style>
          @page{size:A4;margin:10mm}
          *{box-sizing:border-box}

          body{
            font-family:Arial,sans-serif;
            background:#f5faf5;
            padding:0;
            margin:0;
            color:#111827;
            -webkit-print-color-adjust:exact;
            print-color-adjust:exact;
          }

          .receipt-doc{
            width:100%;
            max-width:790px;
            margin:auto;
            background:#fff;
            border-radius:18px;
            overflow:hidden;
            border:1px solid #dce8d7;
            position:relative;
          }

          .watermark{
            position:absolute;
            top:50%;
            left:50%;
            transform:translate(-50%,-50%) rotate(-28deg);
            font-size:92px;
            font-weight:900;
            color:#15803d;
            opacity:.06;
            z-index:0;
            pointer-events:none;
            white-space:nowrap;
          }

          .content{
            position:relative;
            z-index:2;
            padding:28px;
          }

          .top{
            display:flex;
            justify-content:space-between;
            align-items:flex-start;
            gap:20px;
            margin-bottom:24px;
          }

          .company{
            flex:1;
          }

          .company-head{
            display:flex;
            align-items:center;
            gap:14px;
            margin-bottom:12px;
          }

          .logo{
            width:78px;
            height:78px;
            object-fit:contain;
            border-radius:14px;
          }

          .company h1{
            margin:0;
            font-size:34px;
            color:#065f46;
            line-height:1;
          }

          .tag{
            margin-top:6px;
            font-size:15px;
            color:#166534;
            font-weight:600;
          }

          .company-info{
            margin-top:12px;
            line-height:1.8;
            color:#374151;
            font-size:14px;
          }

          .receipt-box{
            width:280px;
            border:2px solid #15803d;
            border-radius:14px;
            overflow:hidden;
          }

          .receipt-title{
            background:#15803d;
            color:white;
            text-align:center;
            padding:12px;
            font-size:24px;
            font-weight:900;
          }

          .receipt-meta{
            padding:18px;
          }

          .meta-row{
            display:grid;
            grid-template-columns:115px 1fr;
            gap:10px;
            margin-bottom:12px;
            font-size:15px;
          }

          .meta-row b{
            color:#065f46;
            text-align:right;
          }

          .section-grid{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:18px;
            margin-bottom:22px;
          }

          .card{
            border:1px solid #dce8d7;
            border-radius:14px;
            overflow:hidden;
          }

          .card-title{
            background:#eef6ec;
            color:#065f46;
            font-size:18px;
            font-weight:900;
            padding:12px 16px;
          }

          .card-body{
            padding:16px;
            line-height:1.9;
            font-size:15px;
          }

          .info-line{
            display:grid;
            grid-template-columns:140px 1fr;
            gap:10px;
          }

          .info-line span:first-child{
            color:#6b7280;
          }

          table{
            width:100%;
            border-collapse:collapse;
            margin-top:10px;
            font-size:14px;
            table-layout:fixed;
          }

          thead{
            background:#15803d;
            color:white;
          }

          th{
            padding:14px 12px;
            text-align:left;
            white-space:nowrap;
          }

          td{
            padding:14px 12px;
            border-bottom:1px solid #e5e7eb;
            vertical-align:top;
          }

          th:nth-child(1),td:nth-child(1){width:50px;text-align:center}
          th:nth-child(2),td:nth-child(2){width:300px}
          th:nth-child(3),td:nth-child(3){width:70px;text-align:center}
          th:nth-child(4),td:nth-child(4){width:150px;text-align:right}
          th:nth-child(5),td:nth-child(5){width:150px;text-align:right}

          .totals{
            width:340px;
            margin-left:auto;
            margin-top:18px;
            border:1px solid #dce8d7;
            border-radius:14px;
            overflow:hidden;
          }

          .total-row{
            display:grid;
            grid-template-columns:1fr 150px;
            padding:14px 18px;
            border-bottom:1px solid #e5e7eb;
          }

          .total-row b,
          .total-row span:last-child{
            text-align:right;
          }

          .grand{
            background:#eef6ec;
            color:#065f46;
            font-size:24px;
            font-weight:900;
          }

          .notes{
            margin-top:26px;
            border:1px solid #dce8d7;
            border-radius:14px;
            overflow:hidden;
          }

          .footer{
            margin-top:22px;
            text-align:center;
            font-size:13px;
            color:#4b5563;
            border-top:1px dashed #d1d5db;
            padding-top:14px;
          }

          .generated-bottom{
            margin-top:10px;
            font-size:12px;
            color:#6b7280;
            font-weight:700;
          }
        </style>
      </head>

      <body>
        <div class="receipt-doc">
          <div class="watermark">PAID</div>

          <div class="content">
            <div class="top">
              <div class="company">
                <div class="company-head">
                  <img src="${kiambuLogo}" class="logo"/>
                  <div>
                    <h1>KIAMBU FERTILIZERS</h1>
                    <div class="tag">Growing Farmers. Growing Future.</div>
                  </div>
                </div>

                <div class="company-info">
                  📍 Gatundu, Kiambu County, Kenya<br/>
                  ☎ +254 700 000 000<br/>
                  ✉ info@kiambufertilizers.co.ke
                </div>
              </div>

              <div class="receipt-box">
                <div class="receipt-title">RECEIPT</div>

                <div class="receipt-meta">
                  <div class="meta-row"><span>Receipt No.</span><b>${receiptNo}</b></div>
                  <div class="meta-row"><span>Invoice No.</span><b>${invoiceNo}</b></div>
                  <div class="meta-row"><span>Date Paid</span><b>${receiptDate}</b></div>
                  <div class="meta-row"><span>Status</span><b>${status}</b></div>
                </div>
              </div>
            </div>

            <div class="section-grid">
              <div class="card">
                <div class="card-title">RECEIVED FROM</div>
                <div class="card-body">
                  <div class="info-line"><span>Name</span><b>${customer}</b></div>
                  <div class="info-line"><span>Email</span><span>${email}</span></div>
                  <div class="info-line"><span>Phone</span><span>${phone}</span></div>
                  <div class="info-line"><span>Address</span><span>${address}</span></div>
                </div>
              </div>

              <div class="card">
                <div class="card-title">PAYMENT REFERENCE</div>
                <div class="card-body">
                  <div class="info-line"><span>Method</span><b>${paymentMethod}</b></div>
                  <div class="info-line"><span>Invoice</span><span>${invoiceNo}</span></div>
                  <div class="info-line"><span>Receipt</span><span>${receiptNo}</span></div>
                </div>
              </div>
            </div>

            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>PRODUCT / SERVICE</th>
                  <th>QTY</th>
                  <th>UNIT PRICE</th>
                  <th>SUBTOTAL</th>
                </tr>
              </thead>

              <tbody>
                <tr>
                  <td>1</td>
                  <td>${product}</td>
                  <td>${qty}</td>
                  <td>KES ${unitPrice.toLocaleString()}</td>
                  <td>KES ${subtotal.toLocaleString()}</td>
                </tr>
              </tbody>
            </table>

            <div class="totals">
              <div class="total-row">
                <span>Subtotal</span>
                <b>KES ${subtotal.toLocaleString()}</b>
              </div>

              <div class="total-row">
                <span>VAT (${vatRate}%)</span>
                <b>KES ${vat.toLocaleString()}</b>
              </div>

              <div class="total-row grand">
                <span>TOTAL PAID</span>
                <span>KES ${total.toLocaleString()}</span>
              </div>
            </div>

            <div class="notes">
              <div class="card-title">NOTES</div>
              <div class="card-body">
                Payment received successfully. Thank you for choosing Kiambu Fertilizers.
              </div>
            </div>

            <div class="footer">
              This is a system generated receipt and does not require a signature.

              <div class="generated-bottom">
                Generated Date & Time: ${generatedAt}
              </div>
            </div>
          </div>
        </div>
      </body>
      </html>
    `;

    const win = window.open('', '_blank');
    win.document.open();
    win.document.write(html);
    win.document.close();

    setTimeout(() => {
      win.focus();
      win.print();
    }, 500);
  };

  const sendReceipt = (r) => {
    const subject = `Payment Receipt ${r[0]}`;
    const body = `Hello ${r[2]},%0D%0A%0D%0AThank you for your payment.%0D%0AReceipt: ${r[0]}%0D%0AInvoice: ${r[1]}%0D%0AAmount: ${r[4]}%0D%0AStatus: ${r[5]}%0D%0A%0D%0AKiambu Fertilizers Company Limited`;
    window.location.href = `mailto:${r[3]}?subject=${encodeURIComponent(subject)}&body=${body}`;
  };

  return (
    <section>
      <div className="page-header premium-header">
        <div>
          <h2>Receipts</h2>
          <p>Receipts are only available for paid records.</p>
        </div>
      </div>

      <div className="panel">
        <div className="table-toolbar">
          <div>
            <h3>Receipt Center</h3>
            <p>Search, filter, print and send receipts.</p>
          </div>

          <div className="toolbar-actions">
            <input className="search-input" placeholder="Search receipts..." value={search} onChange={e => setSearch(e.target.value)} />
            <select className="filter-select" value={statusFilter} onChange={e => setStatusFilter(e.target.value)}>
              <option>All</option>
              <option>Paid</option>
              <option>Pending</option>
              <option>Cancelled</option>
            </select>
          </div>
        </div>

        <table className="data-table receipts-table">
          <thead>
            <tr>
              <th>Receipt</th>
              <th>Invoice</th>
              <th>Customer</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date</th>
              <th>Payment</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {paginated.map(r => (
              <tr key={r[0]} className="receipt-row">
                <td>
                  <div className="receipt-id-cell">
                    <strong>{r[0]}</strong>
                    <small>{r[1]}</small>
                  </div>
                </td>

                <td>{r[1]}</td>

                <td>
                  <div className="receipt-customer-cell">
                    <strong>{r[2]}</strong>
                    <small>{r[3]}</small>
                  </div>
                </td>

                <td><strong>{r[4]}</strong></td>

                <td>
                  <span className={r[5] === 'Paid' ? 'status success' : 'status warning'}>
                    {r[5]}
                  </span>
                </td>

                <td>{r[6]}</td>

                <td>
                  <span className="invoice-product-chip">{r[13] || 'Payment'}</span>
                </td>

                <td>
                  <div className="receipt-action-buttons">
                    <button
                      title="View Receipt"
                      className="icon-btn view-btn"
                      onClick={() => setSelectedReceipt(r)}
                    >
                      👁️
                    </button>

                    {r[5] === 'Paid' && (
                      <>
                        <button
                          title="Print Receipt"
                          className="icon-btn print-btn"
                          onClick={() => printReceipt(r)}
                        >
                          🖨️
                        </button>

                        <button
                          title="Email Receipt"
                          className="icon-btn edit-btn"
                          onClick={() => sendReceipt(r)}
                        >
                          ✉️
                        </button>

                        <button
                          className="send-receipt-btn"
                          onClick={() => sendReceipt(r)}
                        >
                          Send Receipt
                        </button>
                      </>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <div className="clean-pagination">
          <span>Showing {paginated.length ? ((page - 1) * perPage) + 1 : 0}–{Math.min(page * perPage, filtered.length)} of {filtered.length} receipts</span>

          <div className="pagination-controls">
            <button className="page-btn" disabled={page <= 1} onClick={() => setPage(page - 1)}>←</button>
            <button className="page-number active">{page}</button>
            <button className="page-btn" disabled={page >= totalPages} onClick={() => setPage(page + 1)}>→</button>
          </div>
        </div>
      </div>
      {selectedReceipt && (
        <div className="modal-overlay">
          <div className="customer-popup">
            <div className="popup-header">
              <h3>Receipt Details</h3>
              <button className="close-btn" onClick={() => setSelectedReceipt(null)}>×</button>
            </div>

            <div className="receipt-preview">
              <p><b>Receipt:</b> {selectedReceipt[0]}</p>
              <p><b>Invoice:</b> {selectedReceipt[1]}</p>
              <p><b>Customer:</b> {selectedReceipt[2]}</p>
              <p><b>Email:</b> {selectedReceipt[3]}</p>
              <p><b>Amount:</b> {selectedReceipt[4]}</p>
              <p><b>Status:</b> {selectedReceipt[5]}</p>
              <p><b>Date:</b> {selectedReceipt[6]}</p>
              <p><b>Product:</b> {selectedReceipt[9] || 'Agro Product'}</p>
              <p><b>Quantity:</b> {selectedReceipt[10] || 1}</p>
              <p><b>Payment Method:</b> {selectedReceipt[13] || 'Payment'}</p>
            </div>

            <div className="popup-actions">
              <button className="secondary-btn" onClick={() => setSelectedReceipt(null)}>Close</button>
              {selectedReceipt[5] === 'Paid' && (
                <>
                  <button className="primary-btn" onClick={() => printReceipt(selectedReceipt)}>Print</button>
                  <button className="primary-btn" onClick={() => sendReceipt(selectedReceipt)}>Email</button>
                </>
              )}
            </div>
          </div>
        </div>
      )}

    </section>
  );
}
