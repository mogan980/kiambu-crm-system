import React, { useEffect, useState } from 'react';
import Dashboard from './pages/Dashboard.jsx';
import Customers from './pages/Customers.jsx';
import Products from './pages/Products.jsx';
import Leads from './pages/Leads.jsx';
import Orders from './pages/Orders.jsx';
import Payments from './pages/Payments.jsx';
import Invoices from './pages/Invoices.jsx';
import Receipts from './pages/Receipts.jsx';
import WhatsApp from './pages/WhatsApp.jsx';
import Notifications from './pages/Notifications.jsx';
import CompanySwitcher from './pages/CompanySwitcher.jsx';
import Subscription from './pages/Subscription.jsx';
import Settings from './pages/Settings.jsx';
import './styles/main.css';

function AuthScreen({ onLogin }) {
  const [mode, setMode] = useState('login');
  const [form, setForm] = useState({
    name: '',
    email: '',
    phone: '',
    password: ''
  });

  const submit = () => {
    if (!form.email || !form.password) {
      alert('Enter email and password');
      return;
    }

    if (mode === 'register' && !form.name) {
      alert('Enter your name');
      return;
    }

    const user = {
      name: form.name || 'Admin',
      email: form.email,
      phone: form.phone || '',
      role: 'Admin'
    };

    localStorage.setItem('crm_user', JSON.stringify(user));
    localStorage.setItem('crm_logged_in', 'yes');
    onLogin(user);
  };

  return (
    <div className="auth-page">
      <div className="auth-left">
        <div className="auth-brand">
          <div>K</div>
          <span>Kiambu CRM</span>
        </div>

        <h1>{mode === 'login' ? 'Welcome Back' : 'Create Account'}</h1>
        <p>Sign in to manage customers, products, invoices, receipts and WhatsApp operations.</p>

        {mode === 'register' && (
          <>
            <label>Full Name</label>
            <input placeholder="Your name" value={form.name} onChange={e => setForm({...form, name:e.target.value})} />
          </>
        )}

        <label>Email</label>
        <input placeholder="you@company.com" value={form.email} onChange={e => setForm({...form, email:e.target.value})} />

        {mode === 'register' && (
          <>
            <label>Phone Number</label>
            <input placeholder="0700000000" value={form.phone} onChange={e => setForm({...form, phone:e.target.value})} />
          </>
        )}

        <label>Password</label>
        <input type="password" placeholder="••••••••" value={form.password} onChange={e => setForm({...form, password:e.target.value})} />

        <button onClick={submit}>{mode === 'login' ? 'Sign In' : 'Create Account'}</button>

        <p className="auth-switch">
          {mode === 'login' ? "Don't have an account?" : 'Already have an account?'}
          <b onClick={() => setMode(mode === 'login' ? 'register' : 'login')}>
            {mode === 'login' ? ' Create one' : ' Sign in'}
          </b>
        </p>
      </div>

      <div className="auth-right">
        <div className="auth-orb">⚙️</div>
        <h2>Business clarity for ambitious teams.</h2>
        <p>Run CRM, inventory, sales, receipts and communication from one command center.</p>
      </div>
    </div>
  );
}

export default function App() {
  const [page, setPageState] = useState(localStorage.getItem('crm_page') || 'Dashboard');
  const [crmSettings, setCrmSettings] = useState(JSON.parse(localStorage.getItem('crm_settings') || '{}'));
  const [user, setUser] = useState(JSON.parse(localStorage.getItem('crm_user') || 'null'));
  const [loggedIn, setLoggedIn] = useState(localStorage.getItem('crm_logged_in') === 'yes');

  useEffect(() => {
    const settings = JSON.parse(localStorage.getItem('crm_settings') || '{}');
    if (settings.theme) {
      document.documentElement.style.setProperty('--brand-green', settings.theme);
      document.documentElement.style.setProperty('--brand-dark', settings.theme);
    }

    const reloadSettings = () => {
      const fresh = JSON.parse(localStorage.getItem('crm_settings') || '{}');
      setCrmSettings(fresh);
      if (fresh.theme) {
        document.documentElement.style.setProperty('--brand-green', fresh.theme);
        document.documentElement.style.setProperty('--brand-dark', fresh.theme);
      }
    };

    window.addEventListener('crmSettingsUpdated', reloadSettings);
    return () => window.removeEventListener('crmSettingsUpdated', reloadSettings);
  }, []);

  const setPage = (name) => {
    localStorage.setItem('crm_page', name);
    setPageState(name);
  };

  const logout = () => {
    localStorage.removeItem('crm_logged_in');
    setLoggedIn(false);
    setUser(null);
  };

  if (!loggedIn) {
    return <AuthScreen onLogin={(u) => { setUser(u); setLoggedIn(true); }} />;
  }

  const pages = {
    Dashboard: <Dashboard />,
    Customers: <Customers />,
    Products: <Products />,
    Leads: <Leads user={user} />,
    Orders: <Orders />,
    Payments: <Payments />,
    Invoices: <Invoices />,
    Receipts: <Receipts />,
    WhatsApp: <WhatsApp />,
    Notifications: <Notifications />,
    Companies: <CompanySwitcher />,
    Subscription: <Subscription />,
    Settings: <Settings />
  };

  const groups = [
    { title: 'Main', items: [['Dashboard','📊',''], ['Customers','👥',''], ['Products','🌱','24']] },
    { title: 'Sales', items: [['Leads','🎯','18'], ['Orders','🧾',''], ['Payments','💳',''], ['Invoices','📄','12'], ['Receipts','🧾','']] },
    { title: 'Communication', items: [['WhatsApp','💬','5'], ['Notifications','🔔','5']] },
    { title: 'Business', items: [['Companies','🏢',''], ['Subscription','💎',''], ['Settings','⚙️','']] }
  ];

  return (
    <div className="crm-shell">
      <aside className="pro-sidebar">
        <div className="brand-card">
          {crmSettings.logo ? (
            <img className="brand-logo-img" src={crmSettings.logo} alt="Logo" />
          ) : (
            <div className="brand-logo">K</div>
          )}

          <div>
            <h2>{crmSettings.companyName || 'Kiambu CRM'}</h2>
            <p>{crmSettings.companySubtitle || 'Fertilizers Business OS'}</p>
          </div>
        </div>

        <nav className="sidebar-nav">
          {groups.map(group => (
            <div className="nav-group" key={group.title}>
              <span className="nav-group-title">{group.title}</span>

              {group.items.map(([name, icon, badge]) => (
                <button
                  key={name}
                  className={page === name ? 'nav-link active' : 'nav-link'}
                  onClick={() => setPage(name)}
                >
                  <span className="nav-icon">{icon}</span>
                  <span>{name}</span>
                  {badge && <b>{badge}</b>}
                </button>
              ))}
            </div>
          ))}
        </nav>

        <div className="user-card-clean">
          <div className="user-avatar">{(user?.name || 'Admin').slice(0,2).toUpperCase()}</div>
          <div>
            <small>Logged in as</small>
            <strong>{user?.name || 'Admin'}</strong>
            <p>{user?.role || 'Active user'}</p>
          </div>
        </div>

        <button className="logout-btn" onClick={logout}>Logout</button>
      </aside>

      <main className="crm-main">
        {pages[page] || <Dashboard />}
      </main>
    </div>
  );
}
